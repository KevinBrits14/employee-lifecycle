# Local development (SQLite) — path is relative to the prisma/ folder
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# Production options (pick one, update DATABASE_URL, then run migrations)
# ---------------------------------------------------------------------------

# Neon Postgres (recommended for Vercel):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Turso (libSQL / SQLite edge):
# 1. npm install @libsql/client @prisma/adapter-libsql
# 2. Use provider = "sqlite" with a Turso URL, or follow Turso + Prisma docs
# DATABASE_URL="libsql://YOUR-DB.turso.io"
# TURSO_AUTH_TOKEN="your-token"

# After changing providers, update prisma/schema.prisma datasource provider
# (sqlite → postgresql for Neon), then:
#   npx prisma db push
#   npm run db:seed
