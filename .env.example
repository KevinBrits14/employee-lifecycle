# Supabase Postgres — runtime uses the Transaction pooler
DATABASE_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection — used by prisma db push / migrate
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.PROJECT_REF.supabase.co:5432/postgres"

# On Vercel, set both DATABASE_URL and DIRECT_URL in Project Settings -> Environment Variables.
